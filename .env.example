# ─────────────────────────────────────────────────────────────
#  คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าของคุณ
#  แผนที่ใช้ OpenStreetMap เสมอ ไม่ต้องใช้คีย์
#  (ถ้าไม่ใส่อะไรเลย แอปยังรันได้ในโหมดสาธิต:
#   ระบบเรียลไทม์ระหว่างแท็บในเบราว์เซอร์เดียวกัน)
# ─────────────────────────────────────────────────────────────

# ── เลือกฐานข้อมูลเรียลไทม์: firebase | supabase | local ──────
# เว้นว่าง = ตรวจอัตโนมัติจากค่าที่กรอกด้านล่าง
VITE_REALTIME_PROVIDER=

# ── Firebase Realtime Database ──────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ── Supabase ────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
