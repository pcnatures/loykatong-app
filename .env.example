# ─────────────────────────────────────────────────────────────
#  คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าของคุณ
#  (ถ้าไม่ใส่อะไรเลย แอปยังรันได้ในโหมดสาธิต: แผนที่ OpenStreetMap
#   + ระบบเรียลไทม์ระหว่างแท็บในเบราว์เซอร์เดียวกัน)
# ─────────────────────────────────────────────────────────────

# ── Google Maps (ไม่บังคับ) ──────────────────────────────────
# เปิดใช้: Maps JavaScript API, Places API (New), Geocoding API
VITE_GOOGLE_MAPS_API_KEY=
# Map ID สำหรับ Advanced Markers (เว้นว่าง = ใช้ DEMO_MAP_ID)
VITE_GOOGLE_MAPS_MAP_ID=

# ── เลือกฐานข้อมูลเรียลไทม์: firebase | supabase | local ──────
# เว้นว่าง = ตรวจอัตโนมัติจากค่าที่กรอกด้านล่าง
VITE_REALTIME_PROVIDER=

# ── Firebase Realtime Database ──────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ── Supabase ────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
